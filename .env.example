# ── 应用 ──
APP_NAME=ai-resume-coach
ENVIRONMENT=development
API_PORT=3001
WEB_PORT=3000
# CORS：生产用显式来源，禁止 *
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── 数据库（PostgreSQL + pgvector，dev 用 pgvector 镜像）──
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resume_coach

# ── Redis / ARQ ──
REDIS_URL=redis://localhost:6379/0

# ── DeepSeek（模型 ID 配置化，关注 2026-07-24 chat/reasoner 弃用）──
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_CHAT_MODEL=deepseek-v4-flash
LLM_EMBED_MODEL=deepseek-embedding
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_REQUEST_TIMEOUT=60
LLM_MAX_RETRIES=3

# ── 成本护栏（R2-M2，具体数字）──
LLM_COST_CAP_PER_RESUME=0.01        # 单份成本熔断（美元）
LLM_CONCURRENCY=6                    # 全局并发信号量
LLM_DAILY_BUDGET=5.0                 # 日预算（美元，dev 默认）
LLM_FAILURE_THRESHOLD=3              # 连续失败次数 → 降级

# ── 匿名访问控制（R2-C2）──
ACCESS_TOKEN_BYTES=32                # token_urlsafe(32) ≈ 256bit
ACCESS_TOKEN_HASH_ALGO=sha256

# ── 存储（dev 本地磁盘；prod 用 minio/cos profile）──
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=data/uploads
STORAGE_MINIO_ENDPOINT=
STORAGE_MINIO_BUCKET=

# ── 岗位源（R2-C1，可配置）──
JOB_SOURCE=onet                      # onet | json
JOB_SOURCE_ZH_OVERLAY=1              # 是否应用中文标题/技能映射
JOB_SOURCE_LIMIT=120                 # MVP 先摄入高频职业数量（控嵌入成本）
JOB_SOURCE_CATEGORIES=              # 可选，按职能筛选（逗号分隔）
ONET_SNAPSHOT_PATH=data/jobs/onet/snapshot.json
CURATED_JOBS_DIR=data/jobs/curated
ZH_OVERLAY_PATH=data/jobs/zh_overlay.json

# ── 文件上传 ──
MAX_UPLOAD_BYTES=10485760            # 10MB
